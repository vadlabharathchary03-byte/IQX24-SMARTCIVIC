# ========================================================
# Ravali Application Configuration Environment Variables
# ========================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=ravali-super-secret-key-change-this-in-production-2026

# DEV_MODE: Set to True to print OTP directly to terminal (No SMS charges!)
# Perfect for local testing and development without SMS credits.
DEV_MODE=True

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ravali_db

# SMS Provider Selection: 'dev', 'twilio', or 'msg91'
# If DEV_MODE=True, the system automatically prints OTP to terminal regardless of provider.
SMS_PROVIDER=dev

# Twilio Credentials (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Credentials (Required if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=RAVALI
MSG91_TEMPLATE_ID=your_dlt_template_id_here
